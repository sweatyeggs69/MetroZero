// Windows resources for MetroZero.exe (generated by CMake from packaging/windows/metrozero.rc.in).
#include <winver.h>

1 ICON "@CMAKE_CURRENT_BINARY_DIR@/metrozero.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "MetroZero project"
            VALUE "FileDescription",  "MetroZero - Metroid: Zero Mission, native"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "MetroZero"
            VALUE "LegalCopyright",   "Unofficial project. No game data included. Metroid is a trademark of Nintendo."
            VALUE "OriginalFilename", "MetroZero.exe"
            VALUE "ProductName",      "MetroZero"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
